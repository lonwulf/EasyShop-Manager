CREATE TABLE category (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    image TEXT
);

upsertCategory:
    INSERT INTO category(id, name, image)
    VALUES (:id, :name, :image)
    ON CONFLICT(id) DO UPDATE SET
        id = :id,
        name = :name;

getCategoryById:
    SELECT * FROM category WHERE id = :id;

getAllCategories:
    SELECT * FROM category;

