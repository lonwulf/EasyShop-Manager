CREATE TABLE product_catalogue (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    category_id TEXT NOT NULL,
    sub_category_id TEXT NOT NULL,
    price REAL NOT NULL,
    buying_price REAL NOT NULL,
    is_bundled INTEGER,
    quantity INTEGER,
    image_url TEXT NOT NULL ,
    serial_no TEXT ,
    brand TEXT,

    FOREIGN KEY(sub_category_id) REFERENCES sub_category(id)
);

insertProduct:
    INSERT OR REPLACE INTO product_catalogue(id, name, description, category_id,sub_category_id, price, buying_price, is_bundled, quantity, image_url, serial_no, brand)
    VALUES (?,?,?,?,?,?,?,?, ?, ?, ?, ?);

selectProductsWithCategory:
    SELECT
        p.id AS product_id,
        p.name AS product_name,
        p.price AS product_price,
        p.buying_price AS product_buying_price,
        p.description AS product_description,
        p.is_bundled AS product_is_bundled,
        p.quantity AS product_quantity,
        p.image_url AS product_image_url,
        p.serial_no AS product_serial_no,
        p.brand AS product_brand,

        b.id AS brand_id,

        s.id AS subcategory_id,
        s.name AS subcategory_name,

        c.id AS category_id,
        c.name AS category_name

    FROM product_catalogue p
    JOIN brand b ON p.brand = b.id
    JOIN sub_category s ON p.sub_category_id = s.id
    JOIN category c ON s.category_id = c.id;

updateProduct:
    UPDATE product_catalogue
    SET
        name = :name,
        price = :price,
        sub_category_id = :sub_category_id,
        is_bundled = :is_bundled,
        quantity = :quantity
    WHERE
        id = :id;

upsertProduct:
    INSERT INTO product_catalogue(id,name, description, category_id, sub_category_id, price, buying_price, is_bundled, quantity,
    image_url, serial_no, brand)
    VALUES (:id, :name, :description, :category_id, :sub_category_id,
    :price, :buying_price, :is_bundled, :quantity, :image_url, :seral_no, :brand)
    ON CONFLICT(id) DO UPDATE SET
        name = :name,
        description = :description,
        category_id = :category_id,
        sub_category_id = :sub_category_id,
        price = :price,
        buying_price = :buying_price,
        is_bundled = :is_bundled,
        quantity = :quantity,
        brand = : brand;

selectProductsByBrand:
    SELECT * FROM product_catalogue WHERE brand = : brand;

getAllProducts:
    SELECT * FROM product_catalogue;

getProductById:
    SELECT * FROM product_catalogue WHERE id = :id;

deleteProduct:
    DELETE FROM product_catalogue
    WHERE
        id = :id;
