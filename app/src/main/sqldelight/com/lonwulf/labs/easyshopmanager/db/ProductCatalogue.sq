CREATE TABLE product_catalogue (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    category_id INTEGER NOT NULL,
    sub_category_id INTEGER NOT NULL,
    price REAL NOT NULL,
    buying_price REAL NOT NULL,
    is_bundled INTEGER,
    quantity INTEGER,
    image_url TEXT NOT NULL ,
    serial_no TEXT ,
    brand_id INTEGER ,
    vendor TEXT,

    FOREIGN KEY(sub_category_id) REFERENCES sub_category(id),
    FOREIGN KEY(category_id) REFERENCES category(id),
    FOREIGN KEY(brand_id) REFERENCES brand(id)
);

insertProduct:
    INSERT INTO product_catalogue( name, description, category_id,sub_category_id, price, buying_price, is_bundled, quantity, image_url, serial_no, brand_id, vendor)
    VALUES (?,?,?,?,?,?,?, ?, ?, ?, ?, ?);

selectProductsWithCategory:
    SELECT
        p.id AS product_id,
        p.name AS product_name,
        p.price AS product_price,
        p.buying_price AS product_buying_price,
        p.description AS product_description,
        p.is_bundled AS product_is_bundled,
        p.quantity AS product_quantity,
        p.image_url AS product_image_url,
        p.serial_no AS product_serial_no,
        p.vendor AS product_vendor,

        b.id AS brand_id,
        b.name AS brand_name,

        s.id AS subcategory_id,
        s.name AS subcategory_name,

        c.id AS category_id,
        c.name AS category_name

    FROM product_catalogue p
    LEFT JOIN brand b ON p.brand_id = b.id
    JOIN sub_category s ON p.sub_category_id = s.id
    JOIN category c ON s.category_id = c.id;

updateProduct:
    UPDATE product_catalogue
    SET
        name = :name,
        description = :description,
        category_id = :category_id,
        sub_category_id = :sub_category_id,
        price = :price,
        buying_price = :buying_price,
        is_bundled = :is_bundled,
        quantity = :quantity,
        image_url = :image_url,
        serial_no = :serial_no,
        brand_id = :brand_id,
        vendor = :vendor
    WHERE
        id = :id;

upsertProduct:
    INSERT INTO product_catalogue(id, name, description, category_id, sub_category_id, price, buying_price, is_bundled, quantity,
    image_url, serial_no, brand_id, vendor)
    VALUES (:id, :name, :description, :category_id, :sub_category_id,
    :price, :buying_price, :is_bundled, :quantity, :image_url, :serial_no, :brand_id, :vendor)
    ON CONFLICT(id) DO UPDATE SET
        name = excluded.name,
        description = excluded.description,
        category_id = excluded.category_id,
        sub_category_id = excluded.sub_category_id,
        price = excluded.price,
        buying_price = excluded.buying_price,
        is_bundled = excluded.is_bundled,
        quantity = excluded.quantity,
        brand_id = excluded.brand_id,
        vendor = excluded.vendor,
        image_url = excluded.image_url,
        serial_no = excluded.serial_no;

productWithRelations:
    SELECT
        p.*,
        b.name AS brand_name,
        c.name AS category_name,
        s.name AS subcategory_name
    FROM product_catalogue p
    LEFT JOIN brand b ON p.brand_id = b.id
    JOIN sub_category s ON p.sub_category_id = s.id
    JOIN category c ON s.category_id = c.id;

selectProductsByBrand:
     SELECT
         p.*,
         b.name AS brand_name,
         c.name AS category_name,
         s.name AS subcategory_name
     FROM product_catalogue p
     LEFT JOIN brand b ON p.brand_id = b.id
     JOIN sub_category s ON p.sub_category_id = s.id
     JOIN category c ON s.category_id = c.id
     WHERE brand_id = :brand_id;

getAllProducts:
    SELECT * FROM product_catalogue;

getProductById:
    SELECT
        p.*,
        b.name AS brand_name,
        c.name AS category_name,
        s.name AS subcategory_name
    FROM product_catalogue p
    LEFT JOIN brand b ON p.brand_id = b.id
    JOIN sub_category s ON p.sub_category_id = s.id
    JOIN category c ON s.category_id = c.id
    WHERE p.id = :id;

deleteProduct:
    DELETE FROM product_catalogue
    WHERE
        id = :id;
